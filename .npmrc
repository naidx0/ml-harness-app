# The Solid frontend is vendored at vendor/opencode and imports bare packages
# from there. Node resolves those by walking UP from the importing file, which
# reaches the root node_modules but never web/node_modules. npm's default
# strategy only hoists a package when nothing conflicts, so a dependency could
# land under web/ and become invisible to the vendored tree - which is what
# happened to @tanstack/solid-virtual. This makes hoisting the rule rather than
# the happy accident.
install-strategy=hoisted
