{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Derived from OpenCode's packages/app/tsconfig.json (MIT, ad1a4a6). Checks THIS product's code under web/src. Module paths come from tsconfig.paths.json, which is generated from session-ui's exports map - the same source the Vite resolver reads.",
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src"
  ]
}
